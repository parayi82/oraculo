# Stripe — crea una cuenta en stripe.com, activa Mexico como país
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Crea un precio de suscripción mensual de $49 MXN en el dashboard de Stripe
STRIPE_PRICE_ID=price_...

# Replicate — crea cuenta en replicate.com
REPLICATE_API_TOKEN=r8_...

# Anthropic — para el chat con la Pitonisa
ANTHROPIC_API_KEY=sk-ant-...

# Supabase — proyecto "oraculo" en supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Admin — clave secreta para consultar suscriptores via API
ADMIN_SECRET=una-clave-secreta-tuya

# URL de tu app (sin slash final)
NEXT_PUBLIC_BASE_URL=https://oraculo-mauve-pi.vercel.app
